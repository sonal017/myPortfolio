NODE_ENV=development
PORT=5000
# Required in production. Use a restricted database user, never put this in the frontend.
MONGO_URI=
# Required in production: exact public HTTPS frontend origin, no path.
FRONTEND_URL=
# Optional best-effort mirror after MongoDB persistence. Must return JSON {"success":true}.
GOOGLE_SHEET_URL=
# Leave false unless behind verified trusted proxy IPs/CIDRs. Never use true or a hop count.
TRUST_PROXY=false
